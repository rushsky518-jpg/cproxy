[Unit]
Description=cproxy server - public HTTP reverse tunnel
Documentation=https://example.com/cproxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cproxy
Group=cproxy
EnvironmentFile=-/etc/cproxy/cproxy.env
ExecStart=/usr/local/bin/cproxy server -f /etc/cproxy/server.json
Restart=on-failure
RestartSec=2s
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/cproxy/certs
# Only needed when public_listen uses a port below 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target